{
  "expo": {
    "name": "RECOMP",
    "slug": "recomp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "recomp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.recomp.fitness",
      "infoPlist": {
        "NSCameraUsageDescription": "Take progress photos of your transformation",
        "NSPhotoLibraryUsageDescription": "Import progress photos from your gallery"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#F7F4FF"
      },
      "package": "com.recomp.fitness",
      "permissions": [
        "CAMERA",
        "POST_NOTIFICATIONS",
        "VIBRATE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F7F4FF"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      "expo-sqlite",
      "@react-native-vector-icons/material-design-icons",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Import progress photos from your gallery",
          "cameraPermission": "Take progress photos of your transformation"
        }
      ],
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}